# Copy this file to .env.simulation on the simulation host
# Never commit real secrets or credentials into the repository.
SMARTROOMWARDEN_RUNTIME_MODE=simulation
SMARTROOMWARDEN_DEVICE_TOKEN=replace-with-simulation-token
SMARTROOMWARDEN_OWN_EMAIL=your-simulation-email@example.com
SMARTROOMWARDEN_HOST=0.0.0.0
SMARTROOMWARDEN_PORT=5000
SMARTROOMWARDEN_SSL=false
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json
